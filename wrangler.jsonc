{
	"name": "photobooth",
	"main": "worker/index.ts",
	"compatibility_date": "2025-11-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/s/*"
		]
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "photobooth-shares"
		},
		{
			"bucket_name": "photobooth-shares",
			"binding": "photobooth_shares",
			"remote": true
		}
	],
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	}
}